---
import Layout from '~/layouts/PageLayout.astro';
import { footerData } from '~/navigation';
const metadata = { title: 'Contact', description: 'Get in touch with Team Odyssey at Amrita Bengaluru.' };
---

<Layout metadata={metadata}>
  <section class="page-spread">
    <div class="page-caption"><span>Team Odyssey / Contact</span><span>Bengaluru, India</span></div>
    <header class="page-intro">
      <p class="pencil-note">There's room for you in the story.</p><h1>Let's make<br />something move.</h1><p>
        Have a question about the rover, want to support the team, or just want to say hello? Write to us.
      </p>
    </header>
    <div class="contact-spread">
      <div>
        <h2>A note to the team.</h2><a class="contact-mail" href="mailto:rover_avvb@blr.amrita.edu"
          >rover_avvb@blr.amrita.edu ↗</a
        ><nav class="contact-socials" aria-label="Team social accounts">
          {
            footerData.socialLinks
              .filter((link) => link.ariaLabel !== 'RSS')
              .map((link) => <a href={link.href}>{link.ariaLabel} ↗</a>)
          }
        </nav>
      </div>
      <address class="note-paper">
        <p class="pencil-note">Find us at the workshop</p><p>
          Amrita School of Engineering<br />Amrita Nagar, Choodasandra<br />Junnasandra, Bengaluru<br />Karnataka 560035
        </p><a
          href="https://www.google.com/maps/search/?api=1&query=Amrita+School+of+Engineering+Bengaluru"
          target="_blank"
          rel="noopener noreferrer">Get directions ↗</a
        >
      </address>
    </div>
  </section>
</Layout>
