---
import { Image } from 'astro:assets';
import Layout from '~/layouts/HomeLayout.astro';
import SubsystemNotebook from '~/components/home/SubsystemNotebook';
import HeroTitle from '~/components/home/HeroTitle.astro';
import roverPhoto from '~/assets/images/rover-sunrise.jpeg';
import teamPhoto from '~/assets/images/rover-team.jpeg';
import armPhoto from '~/assets/images/october-arm-post/arm.jpg';
import powerPhoto from '~/assets/images/october-power-distribution/cover.jpeg';
import { sponsors } from '~/data/sponsors';
import { footerData } from '~/navigation';

import ArrowHead from '~/components/scrapbook/ArrowHead.astro';

const sponsorImages = import.meta.glob<{ default: ImageMetadata }>('/src/data/sponsor-logo/*.png', { eager: true });
const milestones = [
  { year: '2020', result: '6th', event: 'Indian Rover Design Challenge' },
  { year: '2020', result: 'Top 20', event: 'International Rover Challenge' },
  { year: '2024', result: '23rd', event: 'ISRO Rover Challenge' },
  { year: '2025', result: 'Finalists', event: 'International Rover Challenge', note: '17th in the SDDR phase' },
];
---

<Layout>
  <main>
    <header class="home-header">
      <a class="wordmark" href="/" aria-label="Team Odyssey home">odyssey<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">The rover</a><a href="/teams">The team</a><a href="/blog">Field notes</a>
        <a class="nav-contact" href="#contact">Say hello <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <section class="intro" aria-label="Introducing Team Odyssey">
      <div class="intro-stage">
        <HeroTitle />
      </div>
    </section>
    <div class="scrapbook">
      <section id="about" class="about spread" aria-labelledby="about-title">
        <div class="spread-top"><span>Team Odyssey</span><span>Bengaluru, India</span></div>
        <div class="about-copy">
          <span class="handwritten margin-note">It started with a “what if?”</span>
          <h2 id="about-title" tabindex="-1">A small lab.<br />A lot of possibility.</h2>
          <p>
            We're Team Odyssey, the official rover team at Amrita's Bengaluru campus. A rag-tag bunch of students from
            different departments, building a rover together.
          </p>
          <p>
            Meet <strong>Skanda</strong>. Built for rough terrain, equipment servicing, autonomous operations, and
            scientific analysis. Every wire, wheel, and line of code has a story behind it.
          </p>
          <a class="ink-link" href="#the-build">Open the build notes <span aria-hidden="true">↘</span></a>
        </div>
        <div class="rover-collage">
          <figure class="polaroid rover-print">
            <span class="tape tape-top" aria-hidden="true"></span><div class="rover-photo-crop">
              <Image
                src={roverPhoto}
                alt="Skanda rover with its arm extended on red dirt at a test site"
                widths={[540, 810]}
                sizes="(max-width: 700px) 85vw, 42vw"
                loading="eager"
              />
            </div><figcaption class="handwritten">Skanda, in its natural habitat.</figcaption>
          </figure>
          <div class="challenge-stamp">
            <span>International<br />Rover Challenge</span><strong>2026</strong><span>Finalists</span>
          </div>
          <span class="handwritten rover-annotation"
            >yes, we built this! <svg viewBox="0 0 100 60" aria-hidden="true"
              ><path d="M5 8Q80 0 85 47m-14-7 14 9 5-17"></path></svg
            ></span
          >
        </div>
        <div class="paper-edge" aria-hidden="true"></div>
      </section>
      <section id="the-build" class="build spread" aria-labelledby="build-title">
        <div class="section-heading">
          <div>
            <p class="small-note">Inside the workshop</p><h2 id="build-title">Many minds.<br />One machine.</h2>
          </div><p>Five subsystems, working as one.<br />Pick a tab. See what goes into Skanda.</p>
        </div>
        <SubsystemNotebook client:visible />
        <noscript
          ><div class="notebook-fallback">
            <h3>The five subsystems</h3><p>
              Computer science programs the rover. Mechanical builds its structure and movement. Electrical integrates
              sensors, power, and communications. Science analyses samples. Media handles outreach, sponsorships, and
              documentation.
            </p><a href="/teams">Meet the team</a>
          </div></noscript
        >
        <div class="build-scraps">
          <figure class="small-print">
            <Image src={armPhoto} alt="Skanda's robotic arm during development" width={440} loading="lazy" /><figcaption
              class="handwritten"
            >
              A helping hand. Literally.
            </figcaption>
          </figure>
          <a class="lined-note" href="/blog"
            ><span class="handwritten">From our workbench</span><h3>The details<br />are in the notes.</h3><p>
              Arm design, power distribution, science, and everything we're figuring out along the way.
            </p><span class="ink-link">Read the field notes <span aria-hidden="true">↗</span></span></a
          >
          <figure class="small-print power-print">
            <Image
              src={powerPhoto}
              alt="The rover's power distribution electronics on the workbench"
              width={440}
              loading="lazy"
            /><figcaption class="handwritten">Getting our wires crossed.</figcaption>
          </figure>
        </div>
      </section>
      <section class="team-spread spread" aria-labelledby="team-title">
        <figure class="polaroid team-print">
          <span class="tape tape-top" aria-hidden="true"></span><Image
            src={teamPhoto}
            alt="Team Odyssey students together at Amrita's Bengaluru campus"
            widths={[640, 1080]}
            sizes="(max-width: 700px) 90vw, 55vw"
            loading="lazy"
          /><figcaption class="handwritten">The people behind the rover. IRC 2026.</figcaption>
        </figure>
        <div class="team-copy">
          <p class="small-note">Meet the crew</p><h2 id="team-title">It takes<br />a whole team.</h2><p>
            Different departments. Different ways of thinking. The same dusty objective.
          </p><p>We're the students who bring Skanda to life, from the design and first sketch to the field.</p><a
            class="ink-link"
            href="/teams">Meet everyone <span aria-hidden="true">↗</span></a
          ><span class="handwritten team-scribble">some assembly (and coffee) required</span>
        </div>
      </section>
      <section class="records spread" aria-labelledby="records-title">
        <div class="section-heading">
          <div><p class="small-note">Saved for the scrapbook</p><h2 id="records-title">A few milestones.</h2></div>
        </div>
        <div class="milestone-list">
          {
            milestones.map((milestone) => (
              <article class="milestone">
                <>
                  <span class="milestone-year">{milestone.year}</span>
                  <h3>{milestone.result}</h3>
                  <p>
                    {milestone.event}
                    {milestone.note && <small>{milestone.note}</small>}
                  </p>
                </>
              </article>
            ))
          }
        </div>
        <a
          class="film-note"
          href="https://www.youtube.com/watch?v=kf187VukHJA"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="play-icon" aria-hidden="true">▶</span><div>
            <h3>See Skanda in action.</h3><p>Our rover functionality demo, from subsystems to the field.</p>
          </div><span class="film-duration">Watch the film <span aria-hidden="true">↗</span></span></a
        >
        <div class="youtube-annotation">
          <ArrowHead /><span class="handwritten youtube-annotation-text">Warning: Opens in YouTube</span>
        </div>
      </section>
      <section id="sponsors" class="sponsors spread" aria-labelledby="sponsors-title">
        <div>
          <p class="small-note">With a little help</p><h2 id="sponsors-title">Part of our story.</h2><p>
            Thank you to the sponsors helping us bring Skanda to life.
          </p>
        </div>
        <div class="sponsor-logos">
          {
            sponsors.map((sponsor) => (
              <a href={sponsor.website} target="_blank" rel="noopener noreferrer">
                <Image
                  src={sponsorImages[`/src/data/sponsor-logo/${sponsor.logo}`].default}
                  alt={sponsor.name}
                  width={220}
                  loading="lazy"
                />
              </a>
            ))
          }
        </div>
      </section>
      <section id="contact" class="contact spread" aria-labelledby="contact-title">
        <div>
          <span class="handwritten">There's room for you in the story.</span><h2 id="contact-title">
            Let's make<br />something move.
          </h2><a class="contact-email" href="mailto:rover_avvb@blr.amrita.edu"
            >rover_avvb@blr.amrita.edu <span aria-hidden="true">↗</span></a
          >
        </div>
        <address class="address-note">
          <span class="tape" aria-hidden="true"></span><span class="handwritten">Find us at the workshop</span><p>
            Amrita School of Engineering<br />Amrita Nagar, Choodasandra<br />Junnasandra, Bengaluru<br />Karnataka
            560035
          </p><a
            class="ink-link"
            href="https://www.google.com/maps/search/?api=1&query=Amrita+School+of+Engineering+Bengaluru"
            target="_blank"
            rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a
          >
        </address>
      </section>
      <footer class="home-footer spread">
        <a class="wordmark" href="/">odyssey.</a><p>Built by students.</p><div>
          {footerData.socialLinks.map((link) => <a href={link.href}>{link.ariaLabel}</a>)}<a href="/links">More links</a
          >
        </div><span>© {new Date().getFullYear()} Team Odyssey</span>
      </footer>
    </div>
  </main>
</Layout>
<script>
  import { initHome } from '~/scripts/home';
  initHome();
  document.addEventListener('astro:page-load', initHome);
</script>
