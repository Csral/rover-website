---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page not found',
  robots: { index: false },
};
---

<Layout metadata={metadata}>
  <section class="missing-page" aria-labelledby="missing-title">
    <div class="missing-note">
      <span class="tape" aria-hidden="true"></span>
      <p class="pencil-note">A page out of place.</p>
      <span class="missing-number" aria-hidden="true">404</span>
      <h1 id="missing-title">Page not found.</h1>
      <p>This page doesn't exist or was moved.</p>
      <a class="ink-link" href="/">Back to the records <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
