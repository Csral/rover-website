---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { footerData } from '~/navigation';
const metadata = { title: 'Links' };
const links = [
  { title: 'GitHub', url: 'https://github.com/TeamOdysseyHQ/', icon: 'tabler:brand-github' },
  { title: 'Instagram', url: 'https://instagram.com/teamodysseyhq', icon: 'tabler:brand-instagram' },
  {
    title: 'LinkedIn',
    url: footerData.socialLinks.find((link) => link.ariaLabel === 'LinkedIn')!.href,
    icon: 'tabler:brand-linkedin',
  },
  { title: 'Contact us', url: '/contact', icon: 'tabler:mail' },
  { title: 'Our records', url: 'http://records.teamodyssey.space/', icon: 'tabler:external-link' },
  { title: 'RSS feed', url: '/rss.xml', icon: 'tabler:rss' },
];
---

<Layout metadata={metadata}>
  <section class="page-spread">
    <div class="page-caption"><span>Team Odyssey / Links</span><span>Keep in touch</span></div>
    <header class="page-intro">
      <p class="pencil-note">A few places to find us.</p><h1>Loose ends.<br />Useful links.</h1><p>
        Follow the build, meet the team, or drop us a note.
      </p>
    </header>
    <div class="link-scraps">
      {
        links.map((link) => (
          <a
            class="note-paper"
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <>
              <Icon name={link.icon} width={27} height={27} />
              <h2>{link.title}</h2>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
