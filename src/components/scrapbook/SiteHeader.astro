---
const path = Astro.url.pathname;
const links = [
  { text: 'Home', href: '/' },
  { text: 'The team', href: '/team' },
  { text: 'Field notes', href: '/blog' },
  { text: 'Links', href: '/links' },
  { text: 'Records', href: 'http://records.teamodyssey.space/' },
];
---

<header class="scrap-nav">
  <a class="scrap-wordmark" href="/" aria-label="Team Odyssey home">odyssey<span>.</span></a>
  <nav class="desktop-links" aria-label="Main navigation">
    {
      links.map(({ text, href }) => (
        <a
          href={href}
          aria-current={path === href || (href === '/blog' && path.startsWith('/blog/')) ? 'page' : undefined}
        >
          {text}
        </a>
      ))
    }
    <a class="scrap-contact-link" href="/contact">Say hello <span aria-hidden="true">↗</span></a>
  </nav>
  <details class="mobile-links">
    <summary>Menu <span aria-hidden="true">＋</span></summary>
    <nav aria-label="Mobile navigation">
      {
        links.map(({ text, href }) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>
            {text}
          </a>
        ))
      }
      <a href="/contact">Say hello ↗</a>
    </nav>
  </details>
</header>
