---
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import Grid from './Grid.astro';
import type { Post } from '~/types';
import { getBlogPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const relatedPosts =
  APP_BLOG.isEnabled && APP_BLOG.isRelatedPostsEnabled ? await getRelatedPosts(post, APP_BLOG.relatedPostsCount) : [];
---

{
  relatedPosts.length > 0 ? (
    <section class="relative mx-auto max-w-7xl px-4 md:px-6 pb-12 md:pb-16 lg:pb-20" aria-labelledby="related-title">
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
        <div class="md:max-w-sm">
          <h2 id="related-title" class="text-3xl font-bold sm:text-4xl font-heading mb-2">
            Related Posts
          </h2>
          {APP_BLOG.list.isEnabled && (
            <a class="text-muted hover:text-primary block mb-6 lg:mb-0" href={getBlogPermalink()}>
              View All Posts »
            </a>
          )}
        </div>
      </div>
      <Grid posts={relatedPosts} />
    </section>
  ) : null
}
