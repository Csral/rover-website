---
import GlobeFallback from './GlobeFallback.astro';
import DeltaBot from './DeltaBot.astro';
import LetterPrinter from './LetterPrinter.astro';
import HeroShip from './HeroShip.astro';
import ink from '~/data/hero-ink.json';
---

<div class="hero-type">
  <h1 class="kinetic-title" aria-label="Team Odyssey">
    <span class="team-stage" aria-hidden="true">
      <span class="pendant-glow"></span>
      <DeltaBot />
      <span class="team-word">
        <HeroShip />
        <span class="hero-letter letter-t">T</span><span class="orbit-pair"
          ><span class="hero-letter letter-e">e</span><span class="hero-letter letter-a">a</span></span
        ><span class="hero-letter letter-m">m</span>
      </span>
    </span>
    <span class="odyssey-word" aria-hidden="true">
      <span class="hero-letter letter-o"
        ><span class="wheel-metric">O</span><span class="wheel-glyph"
          ><span class="wheel-model"
            ><img
              class="wheel-fallback"
              src="/images/odyssey-wheel.webp"
              width="256"
              height="256"
              alt=""
              decoding="async"
            /></span
          ><span class="wheel-globe"><GlobeFallback /></span></span
        ></span
      ><span class="hero-letter letter-d">d</span><span class="hero-letter letter-y-first">y</span><span
        class="hero-letter letter-s-first">s</span
      ><span class="hero-letter letter-s-second">s</span><span class="hero-letter letter-e-last"><LetterPrinter /></span
      ><span class="hero-letter letter-y-last">
        <span class="y-reel"><span>y</span><span aria-hidden="true">y</span><span aria-hidden="true">y</span></span>
      </span>
    </span>
  </h1>
</div>
<svg class="lamp-cables" aria-hidden="true" focusable="false">
  {[0, 1, 2, 3, 4, 5].map((strand) => <path stroke-opacity={1 - (strand % 3) * 0.23} />)}
</svg>
<div class="hero-annotation">
  <span class="typed-note handwritten" aria-label="that's us">that's us</span>
  <svg class="rotating-arrow" viewBox="0 0 240 180" aria-hidden="true">
    <path class="arrow-line" d="M210 130C166 132 91 80 38 25"></path>
    <path class="arrow-head" d="M55 28 38 25 41 43"></path>
  </svg>
  <svg class="return-arrow" viewBox="0 0 240 180" aria-hidden="true">
    <path class="return-line" d="M210 130C161 131 89 78 38 25"></path>
    <path class="return-head" d="M55 28 38 25 41 43"></path>
  </svg>
</div>
<a class="hero-sticky" href="#about" aria-label="Scroll to the scrapbook">
  <span class="tape" aria-hidden="true"></span><span class="handwritten">Scroll away</span>
</a>
<div class="hero-apology" style={`--ink-width: ${ink.width}px`}>
  <svg class="pen-note" viewBox={`0 0 ${ink.width} ${ink.height}`} role="img" aria-label={ink.text}>
    {ink.paths.map((d) => <path d={d} />)}
  </svg>
</div>
