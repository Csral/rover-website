import LOGO from '~/assets/images/scrl-logo.svg';

<style>
	.scroll-indicator-track {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 8px;
		z-index: 9999;
		pointer-events: none;
	}

	.scroll-indicator {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0%;
		height: 8px;
		background: white;
		transition: width 0.05s linear;
	}

	.scroll-indicator-logo {
		position: absolute;
		bottom: 0;
		left: 0%;
		transform: translate(-50%, -100%);
		width: 28px;
		height: 28px;
		transition: left 0.05s linear;
		will-change: left;
	}

	.scroll-indicator-logo img {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>

<div class="scroll-indicator-track">
	<div id="scrlind" class="scroll-indicator"></div>
	<div id="scrllogo" class="scroll-indicator-logo">
		<img src={LOGO} alt="logo" />
	</div>
</div>

<script lang="ts">
	window.addEventListener("scroll", updateBar);
	window.addEventListener("resize", updateBar);

	function updateBar(): void {
		const scrolltop = window.scrollY;
		const docheight = document.documentElement.scrollHeight - window.innerHeight;
		const progress = docheight > 0 ? (scrolltop / docheight) * 100 : 0;

		const bar = document.getElementById("scrlind") as HTMLDivElement | null;
		const logo = document.getElementById("scrllogo") as HTMLDivElement | null;

		if (bar) {
			bar.style.width = `${progress}%`;
		}
		if (logo) {
			logo.style.left = `${progress}%`;
		}
	}

	updateBar();
</script>
