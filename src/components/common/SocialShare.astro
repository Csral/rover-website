---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
const encodedUrl = encodeURIComponent(String(url));
const encodedText = encodeURIComponent(text);
const links = [
  {
    label: 'Share on X',
    icon: 'tabler:brand-x',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`,
  },
  {
    label: 'Share on Facebook',
    icon: 'tabler:brand-facebook',
    href: `https://www.facebook.com/sharer.php?u=${encodedUrl}`,
  },
  {
    label: 'Share on LinkedIn',
    icon: 'tabler:brand-linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
  {
    label: 'Share on WhatsApp',
    icon: 'tabler:brand-whatsapp',
    href: `https://wa.me/?text=${encodedText}%20${encodedUrl}`,
  },
  { label: 'Share by email', icon: 'tabler:mail', href: `mailto:?subject=${encodedText}&body=${encodedUrl}` },
];
---

<div class={className}>
  <span class="align-super font-bold text-slate-500 dark:text-slate-400">Share:</span>
  {
    links.map(({ label, icon, href }) => (
      <a
        class="ml-2 rtl:ml-0 rtl:mr-2 inline-flex"
        href={href}
        aria-label={label}
        title={label}
        target={href.startsWith('mailto:') ? undefined : '_blank'}
        rel="noopener noreferrer"
      >
        <Icon
          name={icon}
          class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </a>
    ))
  }
</div>
