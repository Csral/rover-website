---
import { Icon } from 'astro-icon/components';
const socials = [
  { key: 'github', label: 'GitHub', icon: 'tabler:brand-github' },
  { key: 'linkedin', label: 'LinkedIn', icon: 'tabler:brand-linkedin' },
  { key: 'email', label: 'Email', icon: 'tabler:mail' },
  { key: 'website', label: 'Website', icon: 'tabler:world' },
];
---

<dialog id="member-modal" class="member-dialog" aria-labelledby="modal-name">
  <div class="profile-sheet">
    <button type="button" class="profile-close" aria-label="Close details" autofocus>×</button>
    <div class="profile-media">
      <img id="modal-photo" alt="" hidden />
      <span id="modal-avatar" class="profile-avatar" aria-hidden="true" hidden></span>
    </div>
    <div class="profile-details">
      <header class="profile-heading">
        <h3 id="modal-name"></h3>
        <p id="modal-role"></p>
        <span id="modal-subdivision" class="profile-subdivision" hidden></span>
      </header>
      <div class="profile-field" data-field="speciality" hidden>
        <span class="profile-label">Speciality</span><p id="modal-speciality"></p>
      </div>
      <div class="profile-field" data-field="about" hidden>
        <span class="profile-label">About</span><p id="modal-about"></p>
      </div>
      <div class="profile-field" data-field="socials" hidden>
        <span class="profile-label">Connect with me</span>
        <div class="profile-socials">
          {
            socials.map(({ key, label, icon }) => (
              <a
                data-social={key}
                href="#"
                target={key === 'email' ? undefined : '_blank'}
                rel={key === 'email' ? undefined : 'noopener noreferrer'}
                aria-label={label}
                title={label}
                hidden
              >
                <Icon name={icon} width={18} height={18} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  .member-dialog {
    width: min(1100px, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid #756b5d;
    border-radius: 2px;
    background: #222123;
    color: #d7d1c6;
    box-shadow: 0 25px 50px #0008;
    overflow: auto;
  }
  .member-dialog::backdrop {
    background: #000b;
    backdrop-filter: blur(8px);
  }
  .profile-sheet {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr);
  }
  .profile-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 44px;
    height: 44px;
    border: 1px solid #756b5d;
    border-radius: 2px;
    background: #222123;
    color: #e6e0d5;
    font-size: 26px;
    cursor: pointer;
  }
  .profile-media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
    background: var(--paper);
  }
  .profile-media img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100svh - 34px);
    object-fit: contain;
  }
  .profile-avatar {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border: 3px solid #756b5d;
    border-radius: 50%;
    font-weight: 700;
    font-size: 30px;
    color: #fff1df;
  }
  .profile-details {
    padding: 48px 28px 28px;
    max-height: calc(100svh - 34px);
    overflow: auto;
  }
  .profile-heading {
    padding-bottom: 22px;
    margin-bottom: 20px;
    border-bottom: 1px solid #756b5d50;
    text-align: center;
  }
  .profile-heading h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 4px;
  }
  #modal-role {
    color: #e18a73;
    font-size: 13px;
    margin: 0;
  }
  .profile-subdivision {
    display: inline-block;
    margin-top: 8px;
    padding: 3px 10px;
    color: #c7ba98;
    background: #3b352d;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .profile-field {
    margin-top: 18px;
  }
  .profile-label {
    display: block;
    margin-bottom: 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a9a39b;
  }
  .profile-field p {
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
    white-space: pre-line;
  }
  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .profile-socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid #756b5d60;
    color: #c7ba98;
    background: #29272a;
  }
  .member-dialog [hidden] {
    display: none !important;
  }
  @media (max-width: 720px) {
    .member-dialog {
      width: calc(100vw - 24px);
      max-height: calc(100svh - 24px);
    }
    .profile-sheet {
      grid-template-columns: 1fr;
    }
    .profile-media {
      min-height: 220px;
    }
    .profile-media img {
      max-height: 48svh;
    }
    .profile-details {
      max-height: none;
      overflow: visible;
      padding: 24px 20px;
    }
  }
</style>
