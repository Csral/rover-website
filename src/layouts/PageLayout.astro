---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/scrapbook/SiteHeader.astro';
import Footer from '~/components/scrapbook/SiteFooter.astro';
import OnThisPage from '~/components/common/OnThisPage.astro';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  showToc?: boolean;
}

const { metadata, showToc = true } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header />
  </slot>
  <div class="relative w-full min-h-screen">
    <main id="page-content" class="scrap-page w-full [&.has-toc]:xl:pr-64 [&.has-toc]:2xl:pr-72">
      <slot />
    </main>
    {showToc && <OnThisPage />}
  </div>
  <slot name="footer">
    <Footer />
  </slot>
</Layout>
